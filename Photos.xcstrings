    "COLLECTIONS_BUDDY_BULLETED_ITEM_ONE_BODY": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "خوارزمية ذكاء اصطناعي جديدة تتيح لك عرض صورك كمشاهد حقيقية من خلال مناظير متعددة.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Ein neuer KI-Algorithmus ermöglicht es dir, deine Fotos als realistische Szenen mit mehreren Perspektiven anzuzeigen.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "A new AI algorithm lets you view your photos as realistic scenes with multiple perspectives.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "A new AI algorithm lets you view your photos as realistic scenes with multiple perspectives.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "A new AI algorithm lets you view your photos as realistic scenes with multiple perspectives.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "A new AI algorithm lets you view your photos as realistic scenes from multiple perspectives.",
            "state": "translated"
          }
        },
        "en_IN": {
          "stringUnit": {
            "value": "A new AI algorithm lets you view your photos as realistic scenes with multiple perspectives.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Un nuevo algoritmo de IA te permite ver tus fotos como escenas realistas con múltiples perspectivas.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Un nuevo algoritmo de IA te permite ver tus fotos como escenas realistas con múltiples perspectivas.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Un nuevo algoritmo de IA te permite ver tus fotos como escenas realistas con múltiples perspectivas.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Un nouvel algorithme d’IA vous permet de visualiser vos photos sous forme de scènes réalistes avec plusieurs perspectives.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Un nouvel algorithme d’IA vous permet de visualiser vos photos sous forme de scènes réalistes avec plusieurs perspectives.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Un nuovo algoritmo di IA ti consente di visualizzare le foto come scenari realistici con varie prospettive.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "新しいAIアルゴリズムにより、写真が複数の視点で楽しめるリアルなシーンになります。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "새로운 AI 알고리즘을 통해 다양한 시점에서 실제 장면처럼 표현된 사진을 감상할 수 있습니다.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "全新AI算法可让你通过逼真场景多视角查看照片。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "全新的AI演算法讓你可以像真實場景一樣以多種視角查看相片。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "新的AI演算法讓你可以像真實場景一樣從多種視角查看照片。",
            "state": "translated"
          }
        }
      }
    },
