{
  "sourceLanguage": "en",
  "strings": {
    "EMPTY_LIBRARY_MESSAGE_SPATIAL": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يمكنك التقاط صور وفيديوهات مكانية بالضغط على الزر العلوي وفتح \"الالتقاط\".",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Du kannst räumliche Fotos und Videos aufnehmen, indem du auf die obere Taste drückst oder „Aufnahme“ öffnest.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "You can take spatial photos and videos by pressing the top button, or opening Capture.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "You can take spatial photos and videos by pressing the top button or opening Capture.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "You can take spatial photos and videos by pressing the top button, or opening Capture.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "You can take spatial photos and videos by pressing the top button or opening Capture.",
            "state": "translated"
          }
        },
        "en_IN": {
          "stringUnit": {
            "value": "You can take spatial photos and videos by pressing the top button, or opening Capture.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Puedes hacer fotos y vídeos espaciales pulsando el botón superior o con la app Captura.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Puedes tomar fotos o videos al presionar el botón superior o abrir Captura.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Puedes tomar fotos o videos al presionar el botón superior o abrir Captura.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Vous pouvez prendre des photos et des vidéos spatiales en appuyant sur le bouton supérieur ou en ouvrant Capture.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Vous pouvez prendre des photos et des vidéos spatiales en appuyant sur le bouton supérieur ou en ouvrant Capture.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Puoi scattare foto e video spaziali premendo il tasto superiore o aprendo l’app Capture.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "トップボタンを押すか、キャプチャを開くと、空間写真や空間ビデオを撮影できます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "상단 버튼을 누르거나, 캡처 앱을 열어서 공간 사진 및 비디오를 찍을 수 있습니다.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "按下顶部按钮或打开“拍摄”即可拍摄空间照片和视频。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "透過按下頂端按鈕或開啟「拍攝」，以拍攝空間相片和影片。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "你可以按下頂端按鈕或打開「拍攝」來拍攝空間照片和影片。",
            "state": "translated"
          }
        }
      }
    },
    "COLLECTIONS_BUDDY_BULLETED_ITEM_TWO_BODY": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "لوحة المعلومات تتضمن ميزات مألوفة مثل البحث العام المرئي والتعليقات المصاحبة ومعلومات الكاميرا.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Das Infofenster verfügt über vertraute Funktionen wie „Visuelles Nachschlagen“, „Untertitel“ und Kamerainformationen.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "The info panel has familiar features like Visual Look Up, captions, and camera information.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "The info panel has familiar features like Visual Look Up, captions and camera information.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "The info panel has familiar features like Visual Look Up, captions, and camera information.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "The info panel has familiar features like Visual Look Up, captions and camera information.",
            "state": "translated"
          }
        },
        "en_IN": {
          "stringUnit": {
            "value": "The info panel has familiar features like Visual Look Up, captions, and camera information.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El panel de información incluye funciones conocidas como el buscador visual, los subtítulos y la información de la cámara.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El panel de información incluye funciones conocidas como la consulta visual, los pies de foto y la información de la cámara.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "El panel de información incluye funciones conocidas como la consulta visual, los pies de foto y la información de la cámara.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Le panneau d’informations intègre des fonctionnalités courantes telles que la recherche visuelle, les légendes et les informations sur la caméra.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Le panneau d’informations comporte des fonctionnalités familières telles que la recherche visuelle, les légendes et les informations sur la caméra.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Il pannello informativo include funzionalità familiari come la ricerca visiva, le didascalie e le informazioni sulla fotocamera.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "情報パネルに、“画像を調べる”、キャプション、カメラ情報などのおなじみの機能が表示されます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "정보 패널에는 시각 정보 찾아보기, 캡션 및 카메라 정보와 같이 익숙한 기능이 있습니다.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "信息面板包含熟悉的功能，如看图查询、说明和相机信息。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "資料面板包括熟悉的功能，例如「圖像查詢」、説明和相機資料。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "資訊面板有熟悉的功能，例如「圖像查詢」、字幕和相機資訊。",
            "state": "translated"
          }
        }
      }
    },
    "PANO_BUDDY_FOOTER": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "استخدم iPhone أو iPad للالتقاط صور بانوراما",
