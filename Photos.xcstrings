    "COLLECTIONS_BUDDY_BULLETED_ITEM_THREE_BODY": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تصنيف الأشخاص والحيوانات الأليفة، بما في ذلك إمكانية إعادة التسمية والمراجعة للحصول على اقتراحات أفضل.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Kategorisiere Personen und Haustiere, einschließlich der Option, sie umzubenennen und zu überprüfen, um bessere Vorschläge zu erhalten.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Categorize people and pets, including the ability to rename and review for better suggestions.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Categorise people and pets, including the ability to rename and review for better suggestions.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Categorize people and pets, including the ability to rename and review for better suggestions.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Categorise people and pets, including the ability to rename and review for better suggestions.",
            "state": "translated"
          }
        },
        "en_IN": {
          "stringUnit": {
            "value": "Categorize people and pets, including the ability to rename and review for better suggestions.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Clasifica las personas y mascotas, y podrás también cambiarles el nombre y revisarlas para obtener mejores sugerencias.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Puedes categorizar a las personas y a las mascotas, e incluso cambiarles el nombre y revisarlas para obtener mejores sugerencias.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Puedes categorizar a las personas y a las mascotas, e incluso cambiarles el nombre y revisarlas para obtener mejores sugerencias.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Catégorisez les personnes et les animaux de compagnie, avec notamment la possibilité de renommer et de vérifier les catégories pour obtenir de meilleures suggestions.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Classez les personnes et les animaux de compagnie, et renommez-les ou modifiez-les pour obtenir de meilleures suggestions.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Categorizza le persone e gli animali domestici, rinominali e rivedili per ottenere suggerimenti migliori.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "人やペットがカテゴリ分けされます。名前を変更したり、より適切な候補を確認したりすることもできます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "사람들 및 반려동물을 카테고리로 분류하고, 이름을 변경하거나 검토하여 더 나은 제안을 받아볼 수 있습니다.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "对人物和宠物进行分类，包括重新命名和检查功能，以获取更佳建议。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "將人物和寵物分類，包括重新命名和檢視功能，以獲得更好的建議。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "分類人物和寵物，包含重新命名和檢視功能，以獲得更好的建議。",
            "state": "translated"
          }
        }
      }
    },
